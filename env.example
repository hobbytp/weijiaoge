# 可选：提高 GitHub API 速率限制
GITHUB_TOKEN=ghp_xxx

# 可选：开启全网检索（SerpAPI）
SERPAPI_KEY=xxxx
SERPER_API_KEY=xxxx
# 可选（若使用 Google Programmable Search）
GOOGLE_CSE_ID=xxxx

# 大模型用例智能提取配置（统一使用 OpenAI 兼容协议，配置任意一个即可自动启用）
# 1. Google Gemini（官方 OpenAI 兼容端点，默认模型 gemini-3.8-flash）
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-3.8-flash

# 2. DeepSeek（原生 OpenAI 兼容协议，高性价比，默认模型 deepseek-chat）
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# 3. OpenAI（默认模型 gpt-4o-mini）
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# 可选：指定首选模型提供商 (gemini / deepseek / openai)，未指定时默认按 gemini -> deepseek -> openai 顺序容灾
LLM_PROVIDER=gemini
